# Terraform state: holds the cluster's real IDs and is never committed
*.tfstate
*.tfstate.*
*.tfstate.backup
# .terraform.lock.hcl IS committed: it pins the exact hash of every provider
# and makes init reproducible on another machine and in CI.
.terraform/
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
!example.tfvars

# Cluster access credentials
kubeconfig*
*.kubeconfig
.kube/

# Machine-local tools, not part of the repository
.tools/
.venv/
__pycache__/

# Working notes stay local, out of the repository. The README is the exception.
*.md
!README.md
importante.txt

# Operating system and editors
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
